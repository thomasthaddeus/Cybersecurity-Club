{
  "name": "cybersecurity-club-template",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@emotion/react": "^11.11.4",
    "@emotion/styled": "^11.11.5",
    "@testing-library/jest-dom": "^6.4.6",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^5.3.4",
    "sitemap": "^8.0.0",
    "web-vitals": "^5.2.0"
  },
  "scripts": {
    "automation:docs": "npm run template:sync && npm run changelog:generate && npm run docs:generate && npm run generate-sitemap",
    "automation:docs:check": "npm run template:sync -- --check && npm run changelog:generate -- --check && npm run docs:generate -- --check",
    "changelog:generate": "node scripts/generate-changelog.js",
    "docs:generate": "node scripts/update-docs-index.js",
    "generate-sitemap": "node generate-sitemap.js",
    "template:configure": "node scripts/configure-template.js",
    "template:sync": "node scripts/sync-template-metadata.js",
    "dev": "vite",
    "start": "vite",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.2",
    "jsdom": "^29.1.1",
    "vite": "^8.0.14",
    "vitest": "^4.1.7"
  }
}
